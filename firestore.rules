rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    function isAdmin()   { return isSignedIn() && role() == 'admin'; }
    function isTeacher() { return isSignedIn() && (role() == 'teacher' || role() == 'admin'); }

    // ── users ─────────────────────────────────────────────────
    match /users/{uid} {
      // 使用者只能讀取自己的資料
      allow read:   if isSignedIn() && request.auth.uid == uid;
      // 管理員可以讀取所有使用者
      allow read:   if isAdmin();
      // 只有管理員可以建立/修改/刪除使用者
      allow write:  if isAdmin();
      // 使用者可以修改自己的資料（但不能改變角色）
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // ── questions ─────────────────────────────────────────────
    match /questions/{qid} {
      allow read:  if isTeacher();
      allow write: if isAdmin();  // 只有管理員可以管理題庫
    }

    // ── exams ─────────────────────────────────────────────────
    match /exams/{eid} {
      // 管理員可以讀取所有試卷
      allow read:  if isAdmin();
      // 教師只能讀取自己建立的試卷
      allow read:  if isTeacher() && resource.data.createdBy == request.auth.uid;
      // 試卷建立者必須是本人，避免教師替其他人建立試卷
      allow create: if isAdmin() || (isTeacher() && request.resource.data.createdBy == request.auth.uid);
      // 教師只能修改自己的試卷，且不得更改建立者
      allow update: if isAdmin() || (isTeacher()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin() || (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── classes（教師的試卷分類）────────────────────────────
    match /classes/{classId} {
      allow read: if isAdmin()
                  || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isTeacher()
                        && resource.data.teacherUid == request.auth.uid
                        && request.resource.data.teacherUid == resource.data.teacherUid);
      allow delete: if isAdmin()
                    || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // ── settings（系統設定）────────────────────────────────
    match /settings/{docId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
    }

    // ── textbooks（課本結構）──────────────────────────────────
    // 管理員與教師可讀（出題頁面需要），只有管理員可寫
    match /textbooks/{subjectId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
      match /books/{bookId} {
        allow read:  if isTeacher();
        allow write: if isAdmin();
        match /chapters/{chapterId} {
          allow read:  if isTeacher();
          allow write: if isAdmin();
        }
      }
    }

    // ── 預設拒絕 ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
