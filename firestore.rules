rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    function isPrimaryAdmin() { return isSignedIn() && role() == 'admin'; }
    function isAdmin() { return isSignedIn() && (role() == 'admin' || role() == 'manager'); }
    function isTeacher() { return isSignedIn() && (role() == 'teacher' || role() == 'admin' || role() == 'manager'); }

    // 本人只能修改明確列出的設定；識別值、信箱、建立日期及角色不可自行寫入。
    function validSelfUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return changed.hasOnly([
        'displayName', 'nickname', 'school', 'serviceUnit', 'avatar',
        'visibleCatalog', 'homeFavoriteBooks', 'examPreferences',
        'textbankStatusVisible', 'updatedAt', 'loginCount', 'lastLoginAt',
        'examCreatedCount', 'examCurrentCount', 'metricsStartedAt'
      ])
      && (!changed.hasAny(['displayName']) || (resource.data.role != 'teacher' && d.displayName is string && d.displayName.size() <= 200))
      && (!changed.hasAny(['nickname']) || (d.nickname is string && d.nickname.size() <= 200))
      && (!changed.hasAny(['school']) || (d.school == null || (d.school is string && d.school.size() <= 500)))
      && (!changed.hasAny(['serviceUnit']) || d.serviceUnit == null || (d.serviceUnit is string && d.serviceUnit.size() <= 500))
      && (!changed.hasAny(['avatar']) || (d.avatar is string && d.avatar.size() <= 240000))
      && (!changed.hasAny(['visibleCatalog']) || d.visibleCatalog is map)
      && (!changed.hasAny(['homeFavoriteBooks']) || (d.homeFavoriteBooks is list && d.homeFavoriteBooks.size() <= 500))
      && (!changed.hasAny(['examPreferences']) || d.examPreferences is map)
      && (!changed.hasAny(['textbankStatusVisible']) || d.textbankStatusVisible is bool)
      && (!changed.hasAny(['updatedAt']) || d.updatedAt == request.time)
      && (!changed.hasAny(['lastLoginAt']) || d.lastLoginAt == request.time)
      && (!changed.hasAny(['metricsStartedAt']) || (resource.data.get('metricsStartedAt', null) == null && d.metricsStartedAt == request.time))
      && (!changed.hasAny(['loginCount']) || (d.loginCount is int && d.loginCount == resource.data.get('loginCount', 0) + 1))
      // 試卷數仍由用戶端同步，僅為顯示統計，不能用於授權或稽核。
      && (!changed.hasAny(['examCreatedCount']) || (d.examCreatedCount is int && (d.examCreatedCount == resource.data.get('examCreatedCount', 0) + 1 || (resource.data.get('examCreatedCount', null) == null && d.examCreatedCount == 0))))
      && (!changed.hasAny(['examCurrentCount']) || (d.examCurrentCount is int && d.examCurrentCount >= 0));
    }

    // ── users ─────────────────────────────────────────────────
    match /users/{uid} {
      // 使用者只能讀取自己的資料
      allow read:   if isSignedIn() && request.auth.uid == uid;
      // 管理員可以讀取所有使用者
      allow read:   if isAdmin();
      // 主要管理員可管理一般管理員與教師；一般管理員只能管理教師。
      // 任何人都不能從網站建立、刪除或變更主要管理員角色。
      allow create: if isAdmin() && request.resource.data.role == 'teacher'
                    || isPrimaryAdmin() && request.resource.data.role == 'manager';
      allow update: if isPrimaryAdmin() && request.auth.uid != uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'school', 'updatedAt'])
                    && resource.data.role != 'admin'
                    && request.resource.data.role in ['manager', 'teacher']
                    || isAdmin() && request.auth.uid != uid
                    && resource.data.role == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'school', 'updatedAt'])
                    && request.resource.data.role == 'teacher'
                    || isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && validSelfUpdate()
                    && (resource.data.role != 'teacher'
                      || request.resource.data.get('displayName', null) == resource.data.get('displayName', null));
      allow delete: if request.auth.uid != uid && (
                    isPrimaryAdmin() && resource.data.role in ['manager', 'teacher']
                    || isAdmin() && resource.data.role == 'teacher');
    }

    // ── questions ─────────────────────────────────────────────
    match /questions/{qid} {
      allow read:  if isTeacher();
      allow write: if isAdmin();  // 只有管理員可以管理題庫
    }

    // ── exams ─────────────────────────────────────────────────
    match /exams/{eid} {
      // 管理員與教師只能存取自己建立的試卷
      allow read:  if isTeacher() && resource.data.createdBy == request.auth.uid;
      // 試卷建立者必須是本人
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.uid;
      // 修改時不得更改建立者
      allow update: if isTeacher()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isTeacher() && resource.data.createdBy == request.auth.uid;
    }

    // ── settings（系統設定）────────────────────────────────
    match /settings/{docId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
    }

    // ── textbooks（課本結構）──────────────────────────────────
    // 管理員與教師可讀（出題頁面需要），只有管理員可寫
    match /textbooks/{subjectId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
      match /books/{bookId} {
        allow read:  if isTeacher();
        allow write: if isAdmin();
        match /chapters/{chapterId} {
          allow read:  if isTeacher();
          allow write: if isAdmin();
        }
      }
    }

    // ── 預設拒絕 ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
