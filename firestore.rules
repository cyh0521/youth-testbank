rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    function isPrimaryAdmin() { return isSignedIn() && role() == 'admin'; }
    function isAdmin() { return isSignedIn() && (role() == 'admin' || role() == 'manager'); }
    function isTeacher() { return isSignedIn() && (role() == 'teacher' || role() == 'admin' || role() == 'manager'); }

    // ── users ─────────────────────────────────────────────────
    match /users/{uid} {
      // 使用者只能讀取自己的資料
      allow read:   if isSignedIn() && request.auth.uid == uid;
      // 管理員可以讀取所有使用者
      allow read:   if isAdmin();
      // 主要管理員可管理一般管理員與教師；一般管理員只能管理教師。
      // 任何人都不能從網站建立、刪除或變更主要管理員角色。
      allow create: if isAdmin() && request.resource.data.role == 'teacher'
                    || isPrimaryAdmin() && request.resource.data.role == 'manager';
      allow update: if isPrimaryAdmin() && request.auth.uid != uid
                    && resource.data.role != 'admin'
                    && request.resource.data.role in ['manager', 'teacher']
                    || isAdmin() && request.auth.uid != uid
                    && resource.data.role == 'teacher'
                    && request.resource.data.role == 'teacher'
                    || isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if request.auth.uid != uid && (
                    isPrimaryAdmin() && resource.data.role in ['manager', 'teacher']
                    || isAdmin() && resource.data.role == 'teacher');
    }

    // ── questions ─────────────────────────────────────────────
    match /questions/{qid} {
      allow read:  if isTeacher();
      allow write: if isAdmin();  // 只有管理員可以管理題庫
    }

    // ── exams ─────────────────────────────────────────────────
    match /exams/{eid} {
      // 管理員與教師只能存取自己建立的試卷
      allow read:  if isTeacher() && resource.data.createdBy == request.auth.uid;
      // 帳號管理的試卷數量統計需要查詢教師名下的試卷。
      allow list:  if isAdmin();
      // 試卷建立者必須是本人
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.uid;
      // 修改時不得更改建立者
      allow update: if isTeacher()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isTeacher() && resource.data.createdBy == request.auth.uid;
    }

    // ── settings（系統設定）────────────────────────────────
    match /settings/{docId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
    }

    // ── textbooks（課本結構）──────────────────────────────────
    // 管理員與教師可讀（出題頁面需要），只有管理員可寫
    match /textbooks/{subjectId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
      match /books/{bookId} {
        allow read:  if isTeacher();
        allow write: if isAdmin();
        match /chapters/{chapterId} {
          allow read:  if isTeacher();
          allow write: if isAdmin();
        }
      }
    }

    // ── 預設拒絕 ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
