rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    function isAdmin()   { return isSignedIn() && role() == 'admin'; }
    function isTeacher() { return isSignedIn() && (role() == 'teacher' || role() == 'admin'); }
    function isStudent() { return isSignedIn() && role() == 'student'; }

    // ── users ─────────────────────────────────────────────────
    match /users/{uid} {
      // 使用者只能讀取自己的資料
      allow read:   if isSignedIn() && request.auth.uid == uid;
      // 管理員可以讀取所有使用者
      allow read:   if isAdmin();
      // 只有管理員可以建立/修改/刪除使用者
      allow write:  if isAdmin();
      // 使用者可以修改自己的資料（但不能改變角色）
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // ── questions ─────────────────────────────────────────────
    match /questions/{qid} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();  // 只有管理員可以管理題庫
    }

    // ── exams ─────────────────────────────────────────────────
    match /exams/{eid} {
      // 管理員可以讀取所有試卷
      allow read:  if isAdmin();
      // 教師只能讀取自己建立的試卷
      allow read:  if isTeacher() && resource.data.createdBy == request.auth.uid;
      // 學生只能讀取已開放且在其班級的試卷（由前端控制，這裡允許讀取已開放試卷）
      allow read:  if isStudent() && resource.data.status == 'active';
      // 只有管理員和教師可以建立試卷
      allow create: if isTeacher();
      // 只有建立者或管理員可以修改/刪除試卷
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── results ───────────────────────────────────────────────
    match /results/{rid} {
      // 管理員可以讀取所有成績
      allow read:   if isAdmin();
      // 教師可以讀取自己班級學生的成績（前端控制）
      allow read:   if isTeacher();
      // 學生只能讀取自己的成績
      allow read:   if isSignedIn() && resource.data.studentUid == request.auth.uid;
      // 學生只能建立自己的成績
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      // 只有教師可以修改成績（批改主觀題）
      allow update: if isTeacher();
    }

    // ── submissions ───────────────────────────────────────────
    match /submissions/{sid} {
      allow read:   if isTeacher();
      allow read:   if isSignedIn() && resource.data.studentUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isTeacher();
    }

    // ── classes ───────────────────────────────────────────────
    match /classes/{classId} {
      // 管理員可以讀取所有班級
      allow read:  if isAdmin();
      // 教師只能讀取自己建立的班級
      allow read:  if isTeacher() && resource.data.teacherUid == request.auth.uid;
      // 學生可以讀取班級資訊（加入班級時需要）
      allow read:  if isStudent();
      // 只有教師可以建立班級
      allow create: if isTeacher();
      // 只有建立者或管理員可以修改/刪除班級
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      
      match /members/{uid} {
        // 教師可以讀取自己班級的成員
        allow read:  if isTeacher();
        // 學生可以讀取成員列表（查看同班同學）
        allow read:  if isSignedIn();
        // 只有教師可以管理成員
        allow write: if isTeacher();
        // 學生可以將自己加入班級
        allow create: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ── settings（系統設定）────────────────────────────────
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── textbooks（課本結構）──────────────────────────────────
    // 所有登入者可讀（出題頁面需要），只有管理員可寫
    match /textbooks/{subjectId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
      match /books/{bookId} {
        allow read:  if isSignedIn();
        allow write: if isAdmin();
        match /chapters/{chapterId} {
          allow read:  if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }

    // ── 預設拒絕 ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
